# Variables de entorno del BACKEND (configurar en Vercel, nunca en Git)
# Copiar como .env.local para desarrollo. NO subir valores reales.

DB_HOST=
DB_PORT=
DB_NAME=
DB_USER=
DB_PASSWORD=
# Alternativa a las cinco anteriores (Aiven la entrega como "Service URI")
# DATABASE_URL=mysql://usuario:password@host:puerto/basededatos
# Certificado CA de Aiven (contenido completo del ca.pem, en una sola variable)
DB_SSL_CA=
# Secreto para firmar los JWT (cadena aleatoria larga)
JWT_SECRET=

# Frontend: vacío en Vercel (mismo dominio /api). Sólo para apuntar a otra API.
VITE_URL_API=
